# ---------------------------------------------------------------------------
# Lead delivery
# ---------------------------------------------------------------------------
# Which CRM adapter the /api/lead endpoint uses. One of:
#   console      — logs the lead only. The default, for local development.
#   webhook      — generic JSON POST. Works with Zapier, Make, n8n, and most
#                  REI CRMs that accept an inbound webhook.
#   gohighlevel  — GoHighLevel inbound webhook format.
#   resend       — emails the lead. Use when there is no CRM endpoint yet.
#
# Adding a new CRM means adding one function to ADAPTERS in src/lib/leads.ts —
# no form or page code changes.
LEAD_ADAPTER=console

# --- webhook adapter -------------------------------------------------------
LEAD_WEBHOOK_URL=
# Optional. Sent as `Authorization: Bearer <secret>`.
LEAD_WEBHOOK_SECRET=

# --- gohighlevel adapter ---------------------------------------------------
GHL_WEBHOOK_URL=

# --- resend adapter --------------------------------------------------------
RESEND_API_KEY=
# Comma-separated list is supported.
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=leads@webuyhouseshouston.com
