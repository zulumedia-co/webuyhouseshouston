# ---------------------------------------------------------------------------
# Lead delivery
# ---------------------------------------------------------------------------
# Which CRM adapter the /api/lead endpoint uses. One of:
#   flowtrack    — app.zulumedia.co (FlowTrack / CloseGPT). THE PRODUCTION TARGET.
#                  See docs/crm-integration.md for the required form fields.
#   console      — logs the lead only. The default, for local development.
#   webhook      — generic JSON POST. Works with Zapier, Make, n8n, and most
#                  REI CRMs that accept an inbound webhook.
#   gohighlevel  — GoHighLevel inbound webhook format.
#   resend       — emails the lead. Use when there is no CRM endpoint yet.
#
# Adding a new CRM means adding one function to ADAPTERS in src/lib/leads.ts —
# no form or page code changes.
LEAD_ADAPTER=console

# --- flowtrack adapter (app.zulumedia.co) ----------------------------------
# The inbound webhook / API endpoint for the cash-offer form in the CRM.
FLOWTRACK_WEBHOOK_URL=
# Only if the endpoint requires auth. Sent as `Authorization: Bearer <key>`.
FLOWTRACK_API_KEY=

# Diagnostics only. Includes the CRM's raw rejection body in the error that gets
# logged, which is useful when a field mapping is wrong — but CRM validation
# errors quote the submitted value back ("Invalid phone: (713) 555-8842"), so
# this puts customer contact details in your logs. Turn on to investigate, then
# turn it off again. Leave unset in normal operation.
LEAD_DEBUG_CRM_ERRORS=

# --- webhook adapter -------------------------------------------------------
LEAD_WEBHOOK_URL=
# Optional. Sent as `Authorization: Bearer <secret>`.
LEAD_WEBHOOK_SECRET=

# --- gohighlevel adapter ---------------------------------------------------
GHL_WEBHOOK_URL=

# --- resend adapter --------------------------------------------------------
# Also used as the automatic FALLBACK: if the primary CRM fails, the lead is
# emailed instead. Strongly recommended even when a CRM is configured — without
# it, a CRM outage leaves the server log as the only surviving copy of the lead,
# which is the one situation where customer details still get written there.
RESEND_API_KEY=
# Comma-separated list is supported.
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=leads@webuyhouseshouston.com
