---
import LocationPage from '@/components/LocationPage.astro';
import { HARRIS_PLACES } from '@/data/places';
import { SITE } from '@/config/site';

/**
 * The legacy site published two URLs with effectively identical Harris County
 * content. Both stay live so no inbound link or ranking is lost, but this one
 * points its canonical at /harris_county/ so Google consolidates the signals
 * onto a single page instead of treating them as duplicates competing with
 * each other.
 */
---

<LocationPage
  area="Harris County"
  title="Sell Your House Fast In Harris County, TX — Cash Offer In 24 Hours"
  description="We buy houses across Harris County, TX in any condition. Fair all-cash offer within 24 hours, close in as little as 7 days, no fees or commissions."
  source="harris"
  places={HARRIS_PLACES}
  canonical={`${SITE.url}/harris_county/`}
/>
