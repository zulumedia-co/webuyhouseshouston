---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import LegalPage from '@/components/LegalPage.astro';
import { SITE, CONTACT, CONSENT } from '@/config/site';
import type { LegalSection } from '@/lib/legal';

/**
 * ⚠️  NEEDS LEGAL REVIEW BEFORE LAUNCH.
 *
 * This replaces the legacy Carrot template, which was materially inaccurate:
 * it described no CRM, no retention practice, no deletion route, and claimed
 * advertising trackers this site does not run. An inaccurate policy is a worse
 * position than a dated one, so it has been rewritten to describe what the
 * site genuinely does — every statement here is checkable against the code in
 * `src/lib/leads.ts` and `src/pages/api/lead.ts`.
 *
 * What is factual (written from the implementation):
 *   - the exact fields collected, and that they go to a CRM processor
 *   - that no advertising or analytics trackers are currently installed
 *   - the SMS/mobile data clause required for A2P 10DLC registration
 *
 * What is a RECOMMENDED DEFAULT and must be confirmed by the business:
 *   - retention periods (24 months for inquiries, 7 years post-transaction)
 *   - the 45-day response window for rights requests
 *   - who internally can access lead data
 *
 * Not claimed anywhere: compliance with any specific statute. The Texas Data
 * Privacy and Security Act largely exempts small businesses, so whether it
 * binds this company is a question for counsel, not for this file. The rights
 * below are offered as good practice regardless.
 *
 * If analytics or advertising pixels are ever added, the "Cookies and
 * tracking" section becomes false and must be updated the same day.
 */

const LAST_UPDATED = 'July 30, 2026';

/**
 * Flip these the day the corresponding tracker actually goes live — not before.
 *
 * The business has said analytics is likely to return and advertising is
 * possible. Describing either as active while it is not would make this policy
 * false, so the copy below is generated from these flags instead: it states the
 * current position accurately and flags the intent, and becomes correct
 * automatically the moment a flag is switched.
 *
 * Note for whoever enables these: adding advertising cookies is the point at
 * which a cookie banner and an opt-out route usually become necessary. Raise it
 * with counsel then rather than after.
 */
const ANALYTICS_ENABLED = false;
const ADVERTISING_ENABLED = false;

/**
 * Deletion and access requests are handled by phone and email. `CONTACT.email`
 * is still null — no address is published anywhere yet — so the email route is
 * only offered once one exists, rather than pointing people at a dead end.
 */
const contactRoute = CONTACT.email
  ? `email us at ${CONTACT.email} or call ${CONTACT.phone}`
  : `call us on ${CONTACT.phone}`;

const sections: LegalSection[] = [
  {
    heading: 'Who we are',
    paragraphs: [
      `${SITE.name} is a real estate investment company based in Houston, Texas. We buy residential property directly from owners. This policy explains what we collect when you use this website or submit one of our forms, what we do with it, and the choices you have.`,
      `We are the controller of the information described here. You can reach us using the details at the end of this page.`,
    ],
  },
  {
    heading: 'Information you give us',
    paragraphs: [
      'When you submit a cash-offer or contact form, we collect the details you enter so we can evaluate the property and get back to you:',
    ],
    bullets: [
      'Property address, city and ZIP code',
      'Your name',
      'Your phone number',
      'Your email address, if you choose to provide one — it is optional',
      'Your intended timescale for selling',
      'Anything you write in the free-text message box',
    ],
  },
  {
    heading: 'Information collected automatically',
    paragraphs: [
      'Alongside your form submission we record which page the form was on, which link or campaign brought you there, the date and time, and your browser’s user-agent string. We use this to know which pages generate genuine inquiries and to investigate submission problems.',
      'Our hosting provider keeps standard server logs, which may include IP addresses, as a normal part of running and securing the site.',
    ],
  },
  {
    heading: 'Mobile information and text messages',
    emphasis: true,
    paragraphs: [
      'If you give us your phone number, we may contact you by call or text about the property you asked us about. Consent to be contacted is not a condition of any purchase or sale.',
      'You can opt out of text messages at any time by replying STOP to any message from us. Reply HELP for assistance. Message frequency varies, and message and data rates may apply.',
      CONSENT.mobileDataClause,
    ],
  },
  {
    heading: 'How we use your information',
    bullets: [
      'To evaluate your property and prepare a cash offer',
      'To contact you about that offer and answer your questions',
      'To carry out a purchase if you accept, including working with a title company',
      'To keep records required for tax, accounting and legal purposes',
      'To understand which parts of this website produce genuine inquiries',
    ],
    paragraphs: [
      'We do not sell your personal information, and we do not share it with third parties for their own marketing.',
    ],
  },
  {
    heading: 'Who we share it with',
    paragraphs: [
      'We share your information only with parties that help us operate, and only to the extent they need it:',
    ],
    bullets: [
      'Our customer relationship management provider, which stores inquiries on our behalf so we can respond to them',
      'Our email delivery provider, used to notify us that an inquiry has arrived',
      'Our website hosting provider',
      'A title company, and where relevant an attorney or escrow agent, if you decide to sell to us',
      'Law enforcement or regulators where we are legally required to disclose',
    ],
    paragraphs2: [
      'These providers act on our instructions and are not permitted to use your information for their own purposes. As stated above, mobile opt-in data is excluded from all sharing other than support services.',
    ],
  },
  {
    heading: 'How long we keep it',
    paragraphs: [
      'If you inquire and we do not end up doing business together, we keep your inquiry for 24 months so that we can recognize you if you come back to us, and then delete it.',
      'If we purchase your property, we keep records of the transaction for 7 years, which reflects normal tax and real-estate record-keeping periods.',
      'If you ask us to delete your information sooner, we will do so — except where we are required to keep a record for legal, tax or accounting reasons. In practice that means we can delete an inquiry at any time, but where we have actually purchased your property we must keep the transaction records for the periods above.',
    ],
  },
  {
    heading: 'Your choices and rights',
    paragraphs: [
      'You can ask us to:',
    ],
    bullets: [
      'Tell you what information we hold about you',
      'Correct anything that is wrong',
      'Delete your information, subject to records we must keep by law',
      'Stop contacting you, by any or all channels',
      'Provide a copy of what you gave us',
    ],
    paragraphs2: [
      `To make any of these requests, ${contactRoute}. We will delete your information when you ask us to, other than records we are legally required to retain — see “How long we keep it” above. We aim to deal with requests promptly and will respond within 45 days at the latest. We will not treat you differently for exercising any of these rights.`,
      'To stop text messages immediately, reply STOP to any message. To stop emails, use the unsubscribe link or simply tell us.',
    ],
  },
  {
    heading: 'Cookies and tracking',
    paragraphs: [
      ANALYTICS_ENABLED
        ? 'We use Google Analytics to understand how people find and use this website — which pages are read, and which ones lead to an inquiry. Google Analytics sets cookies and receives your IP address. We use it for statistics about the site, not to identify you personally.'
        : 'This website does not currently run analytics cookies or trackers. We expect to add website analytics in the future to understand which pages are useful; when we do, we will update this section before it goes live.',
      ADVERTISING_ENABLED
        ? 'We also run advertising that uses cookies to show our ads to people who have visited this site before. You can opt out of personalized advertising through your browser settings or through the advertising provider’s own controls.'
        : 'We do not currently run advertising cookies or remarketing pixels, and we do not follow you across other websites. We may advertise in the future. If we do, we will say so here, describe what is used, and explain how to opt out — before anything is switched on.',
      'Whatever we use, we will not sell your personal information, and mobile opt-in data is never shared for marketing, as described above.',
    ],
  },
  {
    heading: 'How we protect your information',
    paragraphs: [
      'This site is served over an encrypted connection, and form submissions are transmitted encrypted. Access to inquiry records is limited to the people who need it in order to respond to you and to complete a purchase.',
      'No method of transmission or storage is completely secure, and we cannot guarantee absolute security.',
    ],
  },
  {
    heading: 'Children',
    paragraphs: [
      'This site is intended for property owners and is not directed at children. We do not knowingly collect information from anyone under 13. If you believe a child has provided us information, contact us and we will delete it.',
    ],
  },
  {
    heading: 'Other websites',
    paragraphs: [
      'Some pages link to outside resources, such as government foreclosure-prevention guidance. Those sites have their own privacy policies and we are not responsible for their content or practices.',
    ],
  },
  {
    heading: 'Changes to this policy',
    paragraphs: [
      'If we change how we handle your information, we will update this page and change the date shown at the top. Material changes will be reflected here before they take effect.',
    ],
  },
  {
    heading: 'Contact us',
    paragraphs: [
      `If you have any question about this policy, or want to exercise any of the rights described above, ${contactRoute}, or write to us at ${CONTACT.address.street}, ${CONTACT.address.suite}, ${CONTACT.address.city}, ${CONTACT.address.state} ${CONTACT.address.zip}.`,
    ],
  },
];
---

<BaseLayout
  title="Privacy Policy"
  description={`How ${SITE.name} collects, uses, shares and protects your information, including text-message consent and how to opt out.`}
>
  <PageHero
    eyebrow="Legal"
    title="Privacy Policy"
    lead="What we collect when you contact us, what we do with it, who sees it, how long we keep it, and how to tell us to stop."
    crumbs={[{ label: 'Privacy Policy' }]}
  />

  <LegalPage sections={sections} lastUpdated={LAST_UPDATED} />
</BaseLayout>
