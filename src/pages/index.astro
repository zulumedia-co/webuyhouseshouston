---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import OfferForm from '@/components/OfferForm.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import ComparisonTable from '@/components/ComparisonTable.astro';
import SituationsGrid from '@/components/SituationsGrid.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import CtaBand from '@/components/CtaBand.astro';
import PostCard from '@/components/PostCard.astro';
import Icon from '@/components/Icon.astro';
import { CONTACT, SITE } from '@/config/site';
import { FAQS, TRUST_POINTS } from '@/data/content';
import { byNewest } from '@/lib/posts';

const posts = (await getCollection('blog')).sort(byNewest).slice(0, 3);

// Homepage FAQ shows the four highest-intent questions; the rest live on /faq/.
const homeFaqs = FAQS.slice(0, 4);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout
  title="Sell My House Fast Houston — We Buy Houses Houston"
  description={SITE.description}
  schema={[faqSchema]}
>
  <!-- ================= HERO ================= -->
  <section class="relative overflow-hidden bg-navy-900 grain">
    <div
      class="pointer-events-none absolute -left-40 -top-20 h-[34rem] w-[34rem] rounded-full bg-brass-500/[0.08] blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute bottom-0 right-0 h-[24rem] w-[24rem] translate-x-1/3 translate-y-1/3 rounded-full bg-navy-600/20 blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="container-page relative">
      <div class="grid items-center gap-12 py-14 lg:grid-cols-12 lg:gap-16 lg:py-20">
        <div class="lg:col-span-6 xl:col-span-6">
          <p class="eyebrow eyebrow-light">Houston &amp; Harris County, TX</p>

          <h1
            class="mt-6 text-balance font-display text-[2.125rem] font-semibold leading-[1.1] tracking-tight text-white sm:text-display-lg sm:leading-[1.05] lg:text-[3.5rem] lg:leading-[1.03] xl:text-[3.75rem]"
          >
            Sell your house fast in Houston — without the fees, repairs or
            <span class="text-brass-400">uncertainty</span>.
          </h1>

          <p class="mt-7 max-w-xl text-pretty text-lg leading-relaxed text-white/70">
            We are a family-owned Houston company that buys houses directly with
            our own cash. You get a fair written offer within 24 hours, you pick
            the closing date, and we pay every cost along the way.
          </p>

          <ul class="mt-8 grid gap-3 sm:grid-cols-2">
            {[
              'No agent commissions or fees',
              'No repairs — we buy as-is',
              'You choose the closing date',
              'Close in as little as 7 days',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-[0.9375rem] text-white/80">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brass-400" />
                {item}
              </li>
            ))}
          </ul>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#offer" class="btn btn-primary btn-lg" data-analytics="hero-offer">
              Get My Cash Offer
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
            <a href={CONTACT.phoneHref} class="btn btn-ghost-light btn-lg" data-analytics="hero-call">
              <Icon name="phone" class="h-4 w-4" />
              {CONTACT.phone}
            </a>
          </div>

          <p class="mt-6 text-sm text-white/45">
            100% free · 100% no hassle · 100% no obligation
          </p>
        </div>

        <div class="lg:col-span-6 xl:col-span-5 xl:col-start-8" id="offer">
          <OfferForm
            source="homepage-hero"
            heading="What's your house worth in cash?"
            subheading="Tell us where the property is. We'll come back within 24 hours with a fair, written, no-obligation offer."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TRUST STRIP ================= -->
  <div class="border-b border-hairline bg-white">
    <div class="container-page">
      <dl class="grid grid-cols-2 divide-hairline lg:grid-cols-4 lg:divide-x">
        {TRUST_POINTS.map((point) => (
          <div class="border-b border-hairline px-2 py-8 text-center lg:border-b-0 lg:px-6">
            <dt class="font-display text-display-md font-semibold tracking-tight text-navy-900">
              {point.stat}
            </dt>
            <dd class="mt-1.5 text-sm text-ink-muted">{point.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <!-- ================= SITUATIONS ================= -->
  <Section tone="ivory">
    <SectionHeading
      eyebrow="Who we help"
      title="If any of this sounds familiar, we can help"
      lead="We specialise in solving real estate problems. There is no situation we have not seen before, and no judgement about how you got here."
    />
    <div class="mt-12">
      <SituationsGrid />
    </div>
  </Section>

  <!-- ================= PROCESS ================= -->
  <Section tone="navy">
    <SectionHeading
      eyebrow="How it works"
      title="Four steps. No surprises."
      lead="Selling to us is deliberately simple. Here is exactly what happens from the moment you reach out."
      tone="light"
    />
    <div class="mt-14">
      <ProcessSteps tone="light" />
    </div>

    <div class="mt-14 rounded-2xl border border-white/10 bg-white/[0.04] p-6 sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-2xl">
          <h3 class="font-display text-xl font-semibold tracking-tight text-white">
            Timeframe
          </h3>
          <p class="mt-2 leading-relaxed text-white/65">
            Once we get your details we are usually able to make a fair all-cash
            offer within 24 hours. From there we can close in as little as 7 days
            — or on your schedule. Sometimes we can have a check in your hand the
            very same day.
          </p>
        </div>
        <a href="/how-we-buy-houses/" class="btn btn-ghost-light btn-md shrink-0">
          See the full process
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </Section>

  <!-- ================= COMPARISON ================= -->
  <Section tone="white">
    <SectionHeading
      eyebrow="Compare your options"
      title="A higher sale price is not the same as more money in your pocket"
      lead="Even in a sellers' market it is worth running the real numbers. Commissions, closing costs, repairs and three months of holding costs change the picture considerably."
    />
    <div class="mt-12">
      <ComparisonTable />
    </div>
  </Section>

  <!-- ================= FAQ ================= -->
  <Section tone="ivory">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="Questions"
          title="Maybe you have a few questions"
          lead="That's okay — most people do. Here are the ones we're asked most often."
        />
        <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col">
          <a href="/faq/" class="btn btn-outline btn-md">
            Read all questions
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a href={CONTACT.phoneHref} class="btn btn-navy btn-md">
            <Icon name="phone" class="h-4 w-4" />
            Just call us
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <FaqAccordion faqs={homeFaqs} />
      </div>
    </div>
  </Section>

  <!-- ================= BLOG ================= -->
  {posts.length > 0 && (
    <Section tone="white">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading
          eyebrow="From the blog"
          title="Straight answers about selling in Houston"
          class="max-w-2xl"
        />
        <a href="/blog/" class="btn btn-outline btn-md">
          All articles
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </Section>
  )}

  <CtaBand />
</BaseLayout>
