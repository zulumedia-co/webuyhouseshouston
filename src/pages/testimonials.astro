---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { TESTIMONIALS, INDUSTRY_QUOTE } from '@/data/testimonials';
import { CONTACT, SITE } from '@/config/site';

// The metadata below describes what this page actually contains — vetting
// guidance, not reviews — and targets the searches this audience really makes
// ("is X legit", "we buy houses scam"), which no competitor answers. The
// on-page <h1> keeps the legacy "What others say…" wording for continuity.
---

<BaseLayout
  title="How To Check Out A Cash Home Buyer In Houston"
  description="We don't publish testimonials we wrote ourselves. Instead, here are six concrete ways to verify any company offering to buy your Houston house for cash — including us."
>
  <PageHero
    eyebrow="Testimonials"
    title="What others say…"
    lead="It's important to us that the homeowners we work with have a great experience. In the end, we're not happy if we're not able to provide you with the solution you want."
    crumbs={[{ label: 'Testimonials' }]}
  />

  <Section tone="white">
    {TESTIMONIALS.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {TESTIMONIALS.map((t) => (
          <figure class="flex flex-col rounded-xl bg-ivory-100 p-7">
            <span class="font-display text-5xl leading-none text-brass-500/40" aria-hidden="true">
              &ldquo;
            </span>
            <blockquote class="mt-3 flex-1 text-pretty leading-relaxed text-ink-muted">
              {t.quote}
            </blockquote>
            <figcaption class="mt-6 border-t border-hairline pt-5">
              <span class="block font-display text-lg font-semibold tracking-tight text-navy-900">
                {t.name}
              </span>
              <span class="mt-0.5 block text-sm text-ink-subtle">{t.location}</span>
              {t.situation && (
                <span class="mt-2 inline-flex rounded-full bg-brass-500/10 px-2.5 py-1 text-xs font-semibold text-brass-800">
                  {t.situation}
                </span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      /* No published reviews. Rather than pad the page with invented quotes —
         or imply a review drive that isn't happening — this states the position
         plainly and turns the page into something more useful than testimonials:
         how to actually vet a cash buyer. That is genuinely differentiating,
         because no competitor's testimonials page tells you to check them. */
      <div class="mx-auto max-w-3xl">
        <div class="rounded-2xl bg-ivory-100 p-8 sm:p-12">
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-brass-500/12 text-brass-700">
            <Icon name="shield" class="h-6 w-6" />
          </span>
          <h2 class="mt-6 text-balance font-display text-display-md font-semibold tracking-tight text-navy-900">
            We'd rather show you nothing than show you reviews we wrote ourselves
          </h2>
          <div class="mt-5 space-y-4 text-pretty leading-relaxed text-ink-muted">
            <p>
              We don't have published testimonials on this page yet. We could
              easily fill it with anonymous five-star quotes — plenty of sites in
              this business do, and you'd have no way of telling the difference.
              We'd rather be straight with you.
            </p>
            <p class="font-medium text-navy-900">
              So here's something more useful than a testimonial: exactly how to
              check out any company offering to buy your house for cash,
              including us.
            </p>
          </div>
        </div>

        <div class="mt-6 rounded-2xl border border-hairline bg-white p-8 sm:p-10">
          <h3 class="font-display text-xl font-semibold tracking-tight text-navy-900">
            Have we bought your house?
          </h3>
          <p class="mt-3 leading-relaxed text-ink-muted">
            If we've worked together, we'd genuinely like to hear how it went —
            good or bad. Honest feedback from someone who's been through it is
            worth more to the next homeowner than anything we could write.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="/contact-us/" class="btn btn-primary btn-md">
              Tell us how it went
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
            <a href={CONTACT.phoneHref} class="btn btn-outline btn-md">
              <Icon name="phone" class="h-4 w-4" />
              {CONTACT.phone}
            </a>
          </div>
        </div>
      </div>
    )}
  </Section>

  <!-- Industry context, clearly labelled as such. -->
  <Section tone="ivory">
    <SectionHeading
      eyebrow="Industry perspective"
      title="Why homeowners consider a cash buyer"
      align="center"
    />
    <figure class="mx-auto mt-10 max-w-3xl rounded-2xl bg-white p-8 text-center shadow-card ring-1 ring-navy-900/[0.06] sm:p-12">
      <blockquote class="text-pretty font-display text-xl leading-relaxed tracking-tight text-navy-900 sm:text-2xl">
        &ldquo;{INDUSTRY_QUOTE.quote}&rdquo;
      </blockquote>
      <figcaption class="mt-6 text-sm text-ink-subtle">
        <span class="font-semibold text-ink-muted">{INDUSTRY_QUOTE.source}</span>
        <span class="mx-2" aria-hidden="true">·</span>
        Industry commentary, not a customer review
      </figcaption>
    </figure>
  </Section>

  <Section tone="white">
    <SectionHeading
      eyebrow="How to check us out"
      title="Do not take anyone's word for it — including ours"
      align="center"
      lead={`Selling a house is one of the largest financial decisions you will make. Here is how to verify any cash buyer in Houston, ${SITE.name} included.`}
    />

    <div class="mx-auto mt-12 grid max-w-4xl gap-6 sm:grid-cols-2">
      {[
        {
          title: 'Ask for references you can actually call',
          body: 'Ask for two or three recent sellers and then phone them. A buyer who has genuinely closed deals in Houston will have names to give you. Be wary of testimonials with no surname and no city.',
        },
        {
          title: 'Ask which title company they close at',
          body: 'A legitimate buyer closes at a neutral, reputable title company that runs a proper title search. Anyone pushing a "kitchen table closing" — signing papers at your house, no title company — is a serious red flag.',
        },
        {
          title: 'Ask for proof of funds',
          body: 'If someone is buying with cash, they can show you a bank statement or a proof-of-funds letter. If they will not, they are probably planning to assign your contract to another buyer, which means your closing depends on a stranger.',
        },
        {
          title: 'Check the county records yourself',
          body: 'Harris County property records are public and free to search. Look up the company name and see whether they have actually bought and sold property here, and for how long. It takes ten minutes and it is the hardest thing to fake.',
        },
        {
          title: 'Never pay an upfront fee',
          body: 'A genuine cash buyer makes money on the property, not on you. Application fees, "processing" fees, or anything payable before closing is not how this works. Walk away.',
        },
        {
          title: 'Read before you sign — and take your time',
          body: 'Any buyer worth dealing with will give you the contract to read and let you have an attorney look at it. Pressure to sign today, or an offer that "expires tonight", is a tactic — not a deadline.',
        },
      ].map((item) => (
        <div class="rounded-xl bg-ivory-100 p-6">
          <h3 class="font-display text-lg font-semibold tracking-tight text-navy-900">
            {item.title}
          </h3>
          <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-muted">{item.body}</p>
        </div>
      ))}
    </div>

    <p class="mx-auto mt-10 max-w-3xl rounded-xl border-l-2 border-brass-500 bg-ivory-100 p-6 leading-relaxed text-ink-muted">
      <strong class="font-semibold text-navy-900">Hold us to all six of these.</strong>
      If we cannot answer any of them to your satisfaction, do not sell us your
      house. We would rather lose a deal than have someone feel pushed into one.
    </p>
  </Section>

  <CtaBand />
</BaseLayout>
