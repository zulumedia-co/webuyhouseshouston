---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import OfferForm from '@/components/OfferForm.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { CONTACT, SITE } from '@/config/site';

const values = [
  {
    icon: 'shield' as const,
    title: 'We tell you the truth',
    body: 'Sometimes a direct sale is not your best option, and when that is the case we will say so. We would rather point you toward an agent or a HUD counsellor than push you into a deal that does not serve you.',
  },
  {
    icon: 'home' as const,
    title: 'We are local',
    body: 'We are based in Houston and we buy in Houston. We know these neighbourhoods, we know what the market is doing block by block, and we are not a call centre in another state working from a spreadsheet.',
  },
  {
    icon: 'cash' as const,
    title: 'We buy with our own cash',
    body: 'We are not brokering your house to someone else and hoping their financing comes through. When we make an offer, we can close on it — that is what makes a 7-day close possible.',
  },
];
---

<BaseLayout
  title="Our Company — About We Buy Houses Houston"
  description="We Buy Houses Houston is a family-owned real estate solutions company based in Houston. We provide win-win solutions for homeowners facing foreclosure, probate, and burdensome property."
>
  <PageHero
    eyebrow="Our company"
    title={`About ${SITE.name}`}
    lead="We provide win-win solutions to help homeowners get out of their sticky situations — like foreclosure, owning a burdensome property, probate, or anything else."
    crumbs={[{ label: 'Our Company' }]}
  />

  <Section tone="white">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <div class="space-y-6 text-lg leading-relaxed text-ink-muted">
          <p class="font-display text-2xl font-semibold leading-snug tracking-tight text-navy-900">
            {SITE.name} is a real estate solutions company based out of Houston.
            We're a family-owned business.
          </p>
          <p>
            We focus on helping homeowners like you find solutions for your
            problem — whether you're going through a foreclosure, can't sell your
            property, or just need to sell your house for all kinds of reasons.
          </p>
          <p>
            The truth is that the traditional way of selling a house works well
            for a lot of people. If your house is in good condition, you have
            three months to wait, and you don't mind paying a commission, listing
            with a good agent will likely put more money in your pocket. We'll be
            the first to tell you that.
          </p>
          <p>
            But that is not everybody's situation. Some houses need more work than
            the owner can fund. Some sales are on a deadline that a 91-day average
            simply does not fit. Some people are dealing with a foreclosure
            timeline, a probate court, or a divorce that needs to be finished.
            That is where we come in.
          </p>
          <p class="font-medium text-navy-900">
            If you have any questions about how we work, what the process of
            selling a house looks like, how we can help you avoid foreclosure, or
            you just want to learn more about us — don't hesitate to contact us
            anytime.
          </p>
        </div>

        <div class="mt-10 rounded-xl bg-ivory-100 p-7">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-ink-subtle">
            Call us today
          </p>
          <a
            href={CONTACT.phoneHref}
            class="mt-2 inline-flex items-center gap-3 font-display text-4xl font-semibold tracking-tight text-navy-900 transition-colors hover:text-brass-600"
          >
            <Icon name="phone" class="h-7 w-7 text-brass-500" />
            {CONTACT.phone}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 xl:col-span-4 xl:col-start-9">
        <div class="lg:sticky lg:top-28">
          <OfferForm
            source="our-company"
            heading="Get your fair cash offer"
            subheading="Start below and we'll be in touch within 24 hours."
          />
        </div>
      </div>
    </div>
  </Section>

  <Section tone="ivory">
    <SectionHeading
      eyebrow="How we work with homeowners"
      title="What you can expect from us"
      align="center"
    />
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {values.map((value) => (
        <div class="rounded-xl bg-white p-7 ring-1 ring-navy-900/[0.06]">
          <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-brass-500/10 text-brass-600">
            <Icon name={value.icon} class="h-5 w-5" />
          </span>
          <h3 class="mt-5 font-display text-xl font-semibold tracking-tight text-navy-900">
            {value.title}
          </h3>
          <p class="mt-3 leading-relaxed text-ink-muted">{value.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <CtaBand />
</BaseLayout>
