---
import Logo from '@/components/Logo.astro';
import Icon from '@/components/Icon.astro';
import { NAV, CONTACT } from '@/config/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-ivory/85 backdrop-blur-md transition-[border-color,box-shadow,background-color] duration-300"
  data-header
>
  <div class="container-page">
    <div class="flex h-[4.5rem] items-center justify-between gap-6 lg:h-20">
      <a
        href="/"
        class="shrink-0 rounded-md transition-opacity hover:opacity-80"
        aria-label="We Buy Houses Houston — home"
      >
        <Logo />
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        {NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'relative rounded-md px-3 py-2 text-[0.9375rem] font-medium transition-colors',
              isActive(item.href)
                ? 'text-navy-900'
                : 'text-ink-muted hover:text-navy-900',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
            {isActive(item.href) && (
              <span
                class="absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-brass-500"
                aria-hidden="true"
              ></span>
            )}
          </a>
        ))}
      </nav>

      <div class="hidden items-center gap-4 lg:flex">
        <a
          href={CONTACT.phoneHref}
          class="group flex flex-col items-end leading-tight"
          data-analytics="header-call"
        >
          <span class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-ink-subtle">
            Call Us Today
          </span>
          <span
            class="font-display text-lg font-semibold tracking-tight text-navy-900 transition-colors group-hover:text-brass-600"
          >
            {CONTACT.phone}
          </span>
        </a>
        <a href="/get-a-cash-offer-today/" class="btn btn-primary btn-md" data-analytics="header-cta">
          Get My Cash Offer
        </a>
      </div>

      <button
        type="button"
        class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-lg text-navy-900 transition-colors hover:bg-navy-900/5 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu: a full-height panel rather than a cramped dropdown, so the
     phone number and CTA stay thumb-reachable at the bottom. -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  data-menu-panel
>
  <div class="absolute inset-0 bg-navy-950/40 backdrop-blur-sm" data-menu-backdrop></div>

  <div
    class="absolute inset-y-0 right-0 flex w-full max-w-sm translate-x-full flex-col bg-ivory shadow-2xl transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
    data-menu-sheet
  >
    <div class="flex h-[4.5rem] items-center justify-between border-b border-hairline px-5">
      <Logo />
      <button
        type="button"
        class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-lg text-navy-900 transition-colors hover:bg-navy-900/5"
        aria-label="Close menu"
        data-menu-close
      >
        <Icon name="x" class="h-6 w-6" />
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-5 py-6" aria-label="Mobile">
      <ul class="space-y-1">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'flex items-center justify-between rounded-lg px-3 py-3.5 text-lg font-medium transition-colors',
                isActive(item.href)
                  ? 'bg-navy-900/5 text-navy-900'
                  : 'text-ink-muted hover:bg-navy-900/5 hover:text-navy-900',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
              <svg class="h-4 w-4 text-ink-subtle" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
        <li class="pt-2">
          <a
            href="/contact-us/"
            class="flex items-center justify-between rounded-lg px-3 py-3.5 text-lg font-medium text-ink-muted transition-colors hover:bg-navy-900/5 hover:text-navy-900"
          >
            Contact Us
            <svg class="h-4 w-4 text-ink-subtle" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
      </ul>
    </nav>

    <div class="space-y-3 border-t border-hairline px-5 py-5">
      <a href="/get-a-cash-offer-today/" class="btn btn-primary btn-lg w-full">
        Get My Cash Offer
      </a>
      <a href={CONTACT.phoneHref} class="btn btn-outline btn-lg w-full">
        Call {CONTACT.phone}
      </a>
    </div>
  </div>
</div>

<script>
  // Header hairline only appears once the page has scrolled, so the header
  // reads as part of the hero at rest.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const sync = () => {
      const scrolled = window.scrollY > 8;
      header.classList.toggle('border-hairline', scrolled);
      header.classList.toggle('shadow-[0_1px_16px_rgb(11_27_51/0.06)]', scrolled);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  // Mobile menu.
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const sheet = document.querySelector<HTMLElement>('[data-menu-sheet]');
  const toggle = document.querySelector<HTMLElement>('[data-menu-toggle]');
  const closers = document.querySelectorAll('[data-menu-close], [data-menu-backdrop]');

  if (panel && sheet && toggle) {
    let lastFocused: HTMLElement | null = null;

    // Elements that can receive keyboard focus inside the open sheet. Recomputed
    // on each Tab press rather than cached, so it stays correct if the panel's
    // contents ever change.
    const focusable = (): HTMLElement[] =>
      Array.from(
        sheet.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => el.offsetParent !== null);

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      panel.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      toggle.setAttribute('aria-expanded', 'true');
      // Next frame, so the transition actually runs.
      requestAnimationFrame(() => sheet.classList.remove('translate-x-full'));
      sheet.querySelector<HTMLElement>('a, button')?.focus();
    };

    const close = () => {
      sheet.classList.add('translate-x-full');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      const done = () => {
        panel.classList.add('hidden');
        sheet.removeEventListener('transitionend', done);
      };
      sheet.addEventListener('transitionend', done);
      lastFocused?.focus();
    };

    toggle.addEventListener('click', open);
    closers.forEach((el) => el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (panel.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        close();
        return;
      }

      // Trap Tab inside the sheet. Without this, tabbing walks out of the open
      // menu into the header and page content sitting behind the backdrop —
      // invisible to sighted keyboard users, and confusing with a screen reader.
      if (e.key !== 'Tab') return;

      const items = focusable();
      if (items.length === 0) return;

      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement as HTMLElement | null;

      if (e.shiftKey && (active === first || !sheet.contains(active))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (active === last || !sheet.contains(active))) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>
