---
import { blogPagePath, pageWindow } from '@/lib/pagination';

interface Props {
  current: number;
  total: number;
  class?: string;
}
const { current, total, class: className = '' } = Astro.props;
const pages = pageWindow(current, total);

// Only emit an href when the target page actually exists. Static pages are
// generated for 1..total, so `blogPagePath(total + 1)` would point at a page
// that 404s. Greying the control out is not enough: `pointer-events-none` only
// stops mouse clicks, while search engines read the href regardless — so the
// live site was advertising /blog/page/27/ to Google on the last page.
// An <a> without an href is not a link, so there is nothing left to follow.
// When there is no page to move to, the control renders as an invisible <span>
// placeholder rather than an <a> with no href.
//
// Two reasons it is invisible rather than greyed out: an anchor without an href
// has no link role, so `aria-disabled` on it is invalid ARIA; and a greyed-out
// label light enough to read as "disabled" cannot also meet the 4.5:1 contrast
// minimum. Holding the space keeps the page numbers centred, while `invisible`
// and `aria-hidden` mean it is neither seen nor announced.
const hasPrev = current > 1;
const hasNext = current < total;

const arrowBase =
  'inline-flex h-10 items-center gap-1.5 rounded-lg px-3.5 text-sm font-medium transition-colors';
---

{total > 1 && (
  <nav class:list={['flex items-center justify-center gap-1.5', className]} aria-label="Blog pagination">
    {hasPrev ? (
      <a
        href={blogPagePath(current - 1)}
        class={`${arrowBase} text-ink-muted hover:bg-navy-900/5 hover:text-navy-900`}
        aria-label="Previous page"
        rel="prev"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="hidden sm:inline">Previous</span>
      </a>
    ) : (
      <span class={`${arrowBase} invisible`} aria-hidden="true">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none">
          <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="hidden sm:inline">Previous</span>
      </span>
    )}

    {pages.map((page) =>
      page === '…' ? (
        <span class="px-1.5 text-sm text-ink-subtle" aria-hidden="true">…</span>
      ) : (
        <a
          href={blogPagePath(page)}
          class:list={[
            'inline-flex h-10 min-w-10 items-center justify-center rounded-lg px-3 text-sm font-medium transition-colors',
            page === current
              ? 'bg-navy-900 text-white'
              : 'text-ink-muted hover:bg-navy-900/5 hover:text-navy-900',
          ]}
          aria-current={page === current ? 'page' : undefined}
        >
          {page}
        </a>
      ),
    )}

    {hasNext ? (
      <a
        href={blogPagePath(current + 1)}
        class={`${arrowBase} text-ink-muted hover:bg-navy-900/5 hover:text-navy-900`}
        aria-label="Next page"
        rel="next"
      >
        <span class="hidden sm:inline">Next</span>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    ) : (
      <span class={`${arrowBase} invisible`} aria-hidden="true">
        <span class="hidden sm:inline">Next</span>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none">
          <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    )}
  </nav>
)}
