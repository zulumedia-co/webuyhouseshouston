---
import { COMPARISON } from '@/data/content';
import { SITE } from '@/config/site';
import Icon from '@/components/Icon.astro';
---

<div class="overflow-hidden rounded-2xl bg-white shadow-card ring-1 ring-navy-900/[0.06]">
  <!-- Desktop: a true two-column comparison. The "us" column is visually
       elevated so the contrast is felt before a single row is read. -->
  <div class="hidden md:block">
    <table class="w-full border-collapse text-left">
      <caption class="sr-only">
        Comparing selling with a real estate agent against selling to {SITE.name}
      </caption>
      <thead>
        <tr>
          <th scope="col" class="w-[38%] px-6 py-5"><span class="sr-only">Category</span></th>
          <th scope="col" class="px-6 py-5 align-bottom">
            <span class="block text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-ink-subtle">
              Traditional
            </span>
            <span class="mt-1 block font-display text-xl font-semibold tracking-tight text-navy-900">
              Selling with an agent
            </span>
          </th>
          <th scope="col" class="relative bg-navy-900 px-6 py-5 align-bottom">
            <span
              class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brass-500 to-transparent"
              aria-hidden="true"></span>
            <span class="block text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-brass-400">
              Direct sale
            </span>
            <span class="mt-1 block font-display text-xl font-semibold tracking-tight text-white">
              Sold to {SITE.name}
            </span>
          </th>
        </tr>
      </thead>
      <tbody>
        {COMPARISON.map((row) => (
          <tr class="border-t border-hairline">
            <th scope="row" class="px-6 py-5 align-top text-[0.9375rem] font-semibold text-navy-900">
              {row.label}
            </th>
            <td class="px-6 py-5 align-top text-[0.9375rem] text-ink-muted">
              <span class="inline-flex items-start gap-2.5">
                <Icon name="x" class="mt-0.5 h-4 w-4 shrink-0 text-danger/55" />
                <span>{row.agent}</span>
              </span>
            </td>
            <td
              class:list={[
                'bg-navy-900 px-6 py-5 align-top text-[0.9375rem]',
                row.emphasis ? 'font-semibold text-white' : 'text-white/80',
              ]}
            >
              <span class="inline-flex items-start gap-2.5">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brass-400" />
                <span>{row.us}</span>
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Mobile: stacked pairs. A 3-column table at 375px is unreadable, so each
       row becomes its own small card with both answers side by side. -->
  <div class="divide-y divide-hairline md:hidden">
    {COMPARISON.map((row) => (
      <div class="p-5">
        <p class="text-[0.9375rem] font-semibold text-navy-900">{row.label}</p>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <div class="rounded-lg bg-ivory-100 p-3">
            <p class="text-[0.625rem] font-semibold uppercase tracking-[0.12em] text-ink-subtle">
              With an agent
            </p>
            <p class="mt-1.5 text-sm leading-snug text-ink-muted">{row.agent}</p>
          </div>
          <div class="rounded-lg bg-navy-900 p-3">
            <p class="text-[0.625rem] font-semibold uppercase tracking-[0.12em] text-brass-400">
              With us
            </p>
            <p class="mt-1.5 text-sm font-medium leading-snug text-white">{row.us}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<p class="mt-5 text-sm leading-relaxed text-ink-subtle">
  An <strong class="font-semibold text-ink-muted">inspection contingency</strong> lets the buyer
  take time to inspect and then back out of the sale or renegotiate if repairs are needed. A
  <strong class="font-semibold text-ink-muted">financing contingency</strong> gives the buyer room
  to back out if they cannot obtain a loan, or if the home does not appraise for the value the bank
  needs to close. We do not use bank financing, so you never have to worry about our ability to
  close.
</p>
